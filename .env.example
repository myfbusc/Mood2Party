# Copy to .env.local for local development, or add these as build variables in Cloudflare Pages.
# Firebase web app settings (Firebase console > Project settings > Your apps). These are not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Server-side only (Cloudflare Pages > Settings > Variables and secrets). Never put these in the code.
# GEMINI_API_KEY=        (secret, from Google AI Studio)
# FIREBASE_PROJECT_ID=   (same project id as above)
# GEMINI_MODEL=          (optional, default gemini-3.5-flash-lite)
# AI_DAILY_LIMIT=        (optional, default 60 requests per person per day; needs the AI_USAGE KV binding)
