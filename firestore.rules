rules_version = '2';

// Mood2Party: who can read and change what in Cloud Firestore.
// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// Roles: the host (ownerId) and co-hosts (everyone else in memberIds).
// - Host and co-hosts can read and edit the whole plan.
// - Only the host can turn the invite link on or off, remove co-hosts, or delete the party.
// - Someone with the current invite code can add themselves as a co-host.
// - A co-host can remove themselves (leave).
// - Guests with the current RSVP link can read the party's public RSVP page and send or change their own
//   reply, without an account. Only the host and co-hosts can read the replies.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function eventDoc(eventId) { return get(/databases/$(database)/documents/events/$(eventId)); }
    function isMember(eventId) { return signedIn() && me() in eventDoc(eventId).data.memberIds; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function membersChanged() { return request.resource.data.members.diff(resource.data.members).affectedKeys(); }
    function isMemberOf(eventId) { return signedIn() && exists(/databases/$(database)/documents/events/$(eventId)) && me() in eventDoc(eventId).data.memberIds; }

    // A reply from the RSVP page: only these fields, sensible sizes, and the event's current RSVP code
    function validReply(eventId) {
      let d = request.resource.data;
      let code = eventDoc(eventId).data.get('rsvpCode', null);
      return code is string && d.code == code
        && d.keys().hasOnly(['code', 'name', 'status', 'adults', 'kids', 'dietary', 'allergies', 'note', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.status in ['yes', 'maybe', 'no']
        && d.adults is int && d.adults >= 0 && d.adults <= 30
        && d.kids is int && d.kids >= 0 && d.kids <= 30
        && d.dietary is string && d.dietary.size() <= 200
        && d.allergies is string && d.allergies.size() <= 200
        && d.note is string && d.note.size() <= 300
        && d.at is int;
    }

    // The public RSVP page for one party (its id is the unguessable RSVP code)
    match /rsvpPages/{code} {
      allow read: if true;
      allow create, update: if isMemberOf(request.resource.data.eventId)
        && eventDoc(request.resource.data.eventId).data.get('rsvpCode', null) == code;
      allow delete: if isMemberOf(resource.data.eventId);
    }

    // Each person's own settings (what past events taught the app)
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /events/{eventId} {
      // Members can read; "Your events" only asks for events you belong to
      allow read: if signedIn() && me() in resource.data.memberIds;

      // You can only create an event that you own, with yourself as the only member
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()];

      // 1. Host or co-host editing the plan: who has access and the invite link stay the same
      allow update: if signedIn()
        && me() in resource.data.memberIds
        && !changed().hasAny(['ownerId', 'memberIds', 'members', 'inviteCode', 'joinCode']);

      // 2. Host managing access: invite link on/off, removing co-hosts (never themselves, never the owner)
      allow update: if signedIn()
        && me() == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && me() in request.resource.data.memberIds
        && me() in request.resource.data.members
        && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
        && (request.resource.data.get('inviteCode', null) == null || request.resource.data.inviteCode is string)
        && !changed().hasAny(['joinCode']);

      // 3. Joining with the current invite code: add only yourself, as a co-host, and change nothing else
      allow update: if signedIn()
        && !(me() in resource.data.memberIds)
        && resource.data.get('inviteCode', null) is string
        && request.resource.data.joinCode == resource.data.inviteCode
        && changed().hasOnly(['memberIds', 'members', 'joinCode'])
        && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([me()].toSet())
        && membersChanged().hasOnly([me()])
        && request.resource.data.members[me()].role == 'cohost';

      // 4. A co-host leaving: remove only yourself
      allow update: if signedIn()
        && me() in resource.data.memberIds
        && me() != resource.data.ownerId
        && changed().hasOnly(['memberIds', 'members'])
        && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([me()].toSet())
        && membersChanged().hasOnly([me()])
        && !(me() in request.resource.data.members);

      // Only the host can delete the event
      allow delete: if signedIn() && me() == resource.data.ownerId;

      // RSVP replies: anyone with the current RSVP code can send or change a reply (no account);
      // only the host and co-hosts can read them or clear them out
      match /replies/{replyId} {
        allow create, update: if validReply(eventId);
        allow read, delete: if isMember(eventId);
      }

      // Guest groups, shopping items and tasks: the host and co-hosts can read and change them
      match /{collection}/{recordId} {
        allow read, write: if collection in ['guests', 'items', 'tasks'] && isMember(eventId);
      }
    }
  }
}
